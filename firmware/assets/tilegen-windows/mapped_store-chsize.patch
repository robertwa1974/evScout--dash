index 71101f1..69de3ae 100644
--- a/src/mapped_store.hpp
+++ b/src/mapped_store.hpp
@@ -18,6 +18,22 @@
 #include <stdexcept>
 #include "nav_types.hpp"
 
+// WINDOWS PORTABILITY PATCH (not upstream, not a logic change): mingw-w64's
+// ftruncate() wraps the MSVCRT _chsize(), which takes a 32-bit `long` and
+// silently fails past ~2GB. This mapped store starts at 256MB and doubles
+// on grow(), so any dataset needing >2GB of scratch space (e.g. a
+// state-sized OSM extract, not the small test extracts this was built
+// against) fails here with "ftruncate failed during grow" even though
+// there's plenty of disk. _chsize_s() takes a real 64-bit size and has no
+// such limit - redirect ftruncate to it on Windows only.
+#ifdef _WIN32
+#include <io.h>
+static inline int win_ftruncate64(int fd, long long size) {
+    return _chsize_s(fd, size) == 0 ? 0 : -1;
+}
+#define ftruncate(fd, size) win_ftruncate64(fd, size)
+#endif
+
 namespace nav {
 
 class MappedStore
